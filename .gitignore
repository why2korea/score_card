# ============================================================
#  GitHub에 올리지 않을 파일
#  ------------------------------------------------------------
#  이 앱은 서버 없이 브라우저 localStorage에만 기록을 저장하므로
#  ../smartphone 과 달리 이메일 주소·GAS 주소 같은 비밀정보가
#  코드 안에 들어가지 않습니다. 아래는 일반적인 잡파일 제외 목록입니다.
# ============================================================

# ── 클로드 코드 개인 설정 (내 PC 경로가 들어 있습니다) ──
.claude/

# ── 파이썬 찌꺼기 (tools/make_icons.py 실행 시 생길 수 있음) ──
__pycache__/
*.pyc

# ── 운영체제·편집기가 만드는 잡파일 ──
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~

# ── 작업 전 임시 백업 폴더 (수정 작업 시작 전 전체 소스 복사본, 앱 파일 아님) ──
backup_*/

# ── Chrome 원격 디버깅 세션 덤프 (로컬 세션마다 값이 바뀌는 임시 파일) ──
pagelist.json
